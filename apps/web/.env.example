# Copy thành apps/web/.env.local nếu API không chạy ở http://localhost:8000
VITE_API_URL=http://localhost:8000

# Bước 13 (vận hành) — để trống = tắt
# Sentry cho web (DSN của project frontend)
VITE_SENTRY_DSN=
# Umami (phân tích sự kiện, không cookie): địa chỉ script và mã website
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
