# ─────────────────────────────────────────────────────────────────────────────
# Cấu hình backend Jotly (apps/api) — mẫu cho máy local
#
#   Copy-Item .env.example .env      (PowerShell)   |   cp .env.example .env   (bash)
#
# - Giá trị bên dưới chạy được ngay với `docker compose up -d` (MongoDB, MinIO, Mailpit).
# - KHÔNG commit file .env, không dán khóa thật vào chat/issue. Production đặt biến môi trường
#   ở dịch vụ hosting, không dùng file.
# - Danh sách đầy đủ và giá trị mặc định: app/core/config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── Môi trường ───────────────────────────────────────────────────────────────
# local | test | staging | production. production tắt /docs và bắt buộc có SESSION_SECRET.
ENV=local

# ── Cơ sở dữ liệu (MongoDB) ──────────────────────────────────────────────────
# Local: tài khoản dd/dd trong docker-compose.yml. Production: chuỗi kết nối Atlas (mongodb+srv://…).
MONGODB_URI=mongodb://dd:dd@localhost:27017/?authSource=admin
MONGODB_DB=dailydiary
# pytest XÓA SẠCH DB này mỗi lần chạy; tên bắt buộc kết thúc bằng "_test".
MONGODB_TEST_DB=dailydiary_test

# ── Frontend và CORS ─────────────────────────────────────────────────────────
# Địa chỉ web app (chuyển hướng sau đăng nhập) và danh sách origin được gọi API (JSON).
# Lưu ý: localhost và 127.0.0.1 là hai origin khác nhau.
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=["http://localhost:5173"]

# ── Phiên đăng nhập và cookie ────────────────────────────────────────────────
# Khóa ký cookie tạm dd_oauth trong lúc đăng nhập Google. Local/test để trống được (tự sinh mỗi lần chạy);
# môi trường khác thiếu thì API không khởi động. Tạo: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Cookie chỉ gửi qua HTTPS. Local chạy HTTP nên tắt; production luôn để true.
COOKIE_SECURE=false
# Bỏ trống ở local. Production khi web và API khác subdomain thì đặt domain chung, vd:
# COOKIE_DOMAIN=.jotly.app
# Thời hạn phiên (ngày), tự gia hạn khi dùng.
SESSION_TTL_DAYS=30

# ── Đăng nhập Google (OAuth) ─────────────────────────────────────────────────
# Tạo OAuth client "Web application" ở Google Cloud Console; redirect URI phải khớp tuyệt đối.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Đăng nhập thử không cần Google (POST /auth/dev-login, nút "Đăng nhập thử" ở /login). Chỉ có tác dụng khi
# ENV=local hoặc test; bật ở môi trường khác thì API từ chối khởi động. e2e (Playwright) cần true.
DEV_LOGIN=true

# ── Kho ảnh (chuẩn S3: MinIO local, Cloudflare R2/Supabase khi triển khai) ──────
# S3_ENDPOINT_URL: backend gọi kho. S3_PUBLIC_ENDPOINT_URL: địa chỉ trình duyệt truy cập được, dùng để ký link
# upload/xem ảnh (host nằm trong chữ ký). Bucket phải riêng tư và bật CORS cho PUT từ FRONTEND_URL.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dailydiary-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Email (góp ý, xác nhận xóa tài khoản) ────────────────────────────────────
# Local: Mailpit bắt mọi thư, xem ở http://localhost:8025 (không gửi ra Internet).
# Gmail thật: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USER=<gmail>,
#             SMTP_PASSWORD=<App Password 16 ký tự, KHÔNG phải mật khẩu Gmail>.
# Thiếu SMTP_HOST hoặc FEEDBACK_TO_EMAIL: góp ý chỉ lưu vào DB, không gửi thư.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ người gửi; để trống = SMTP_USER.
MAIL_FROM=jotly@localhost
# Hộp thư nhận góp ý của người dùng.
FEEDBACK_TO_EMAIL=feedback@jotly.local

# ── Sao lưu (tác vụ app.jobs.run backup_db / backup_photos / restore_db) ───────
# Kho riêng chuẩn S3, nên KHÁC nhà cung cấp với kho ảnh (vd Backblaze B2: endpoint https://s3.<region>.backblazeb2.com).
# Local: bucket dailydiary-backups trên MinIO (docker compose tạo sẵn). Để trống BACKUP_S3_BUCKET = tác vụ bỏ qua.
BACKUP_S3_ENDPOINT_URL=http://localhost:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=dailydiary-backups
BACKUP_S3_ACCESS_KEY=minioadmin
BACKUP_S3_SECRET_KEY=minioadmin
# Số bản sao lưu DB giữ lại: 3 bản/ngày × 7 ngày (đặc tả 4.2).
BACKUP_KEEP=21

# ── Khác ─────────────────────────────────────────────────────────────────────
# Nơi lưu giới hạn tần suất. memory:// chỉ đúng khi chạy một process; nhiều worker/instance dùng redis://…
RATE_LIMIT_STORAGE_URI=memory://
# Thư mục shared/ (limits.json, icons.json, flag_colors.json). Để trống = <repo>/shared; khi triển khai mà
# không copy cả repo thì trỏ tới bản copy của shared/.
# SHARED_DIR=/app/shared
