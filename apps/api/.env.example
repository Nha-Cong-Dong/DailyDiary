# Copy thành apps/api/.env cho máy local. Không commit file .env.
ENV=local
MONGODB_URI=mongodb://dd:dd@localhost:27017/?authSource=admin
MONGODB_DB=dailydiary
# Test XÓA SẠCH DB này; tên bắt buộc kết thúc bằng "_test"
MONGODB_TEST_DB=dailydiary_test
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_STORAGE_URI=memory://

# Bước 3 (đăng nhập Google) — để trống cho tới khi có OAuth client
# Đăng nhập thử không cần Google: chỉ có tác dụng khi ENV=local hoặc test, production từ chối khởi động nếu bật
DEV_LOGIN=false
COOKIE_SECURE=false
# Chuỗi ngẫu nhiên ≥ 32 ký tự, vd: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Bước 7 (ảnh) — giá trị MinIO local trong docker-compose.yml
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dailydiary-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Bước 12 (góp ý) — local: Mailpit trong docker-compose.yml, xem thư ở http://localhost:8025
# Gmail thật: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, SMTP_USER=<gmail>,
# SMTP_PASSWORD=<App Password 16 ký tự, không phải mật khẩu Gmail>, FEEDBACK_TO_EMAIL=<hộp thư nhận góp ý>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=jotly@localhost
FEEDBACK_TO_EMAIL=

# Bước 13 — sao lưu DB và ảnh sang kho riêng (chuẩn S3). Local: bucket phụ trên MinIO
BACKUP_S3_ENDPOINT_URL=http://localhost:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=minioadmin
BACKUP_S3_SECRET_KEY=minioadmin
BACKUP_KEEP=21
