# Copy thành apps/api/.env cho máy local. Không commit file .env.
ENV=local
MONGODB_URI=mongodb://dd:dd@localhost:27017/?authSource=admin
MONGODB_DB=dailydiary
# Test XÓA SẠCH DB này; tên bắt buộc kết thúc bằng "_test"
MONGODB_TEST_DB=dailydiary_test
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_STORAGE_URI=memory://

# Bước 3 (đăng nhập Google) — để trống cho tới khi có OAuth client
COOKIE_SECURE=false
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Bước 7 (ảnh) — giá trị MinIO local trong docker-compose.yml
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dailydiary-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
